<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.deskflow-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string><MAC_SETUP_ROOT>/deskflow-watchdog.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string><MAC_SETUP_ROOT>/run/deskflow-watchdog.out.log</string>

  <key>StandardErrorPath</key>
  <string><MAC_SETUP_ROOT>/run/deskflow-watchdog.err.log</string>

  <key>WorkingDirectory</key>
  <string><MAC_SETUP_ROOT></string>
</dict>
</plist>

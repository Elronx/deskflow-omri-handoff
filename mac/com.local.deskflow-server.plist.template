<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.deskflow-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string><MAC_SETUP_ROOT>/mac/deskflow-server-wrapper.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DESKFLOW_SETUP_ROOT</key>
    <string><MAC_SETUP_ROOT></string>
    <key>DESKFLOW_LAN_IFACE</key>
    <string>auto</string>
    <key>DESKFLOW_WINDOWS_IP</key>
    <string><WINDOWS_LAN_IP></string>
  </dict>

  <key>StandardOutPath</key>
  <string><MAC_SETUP_ROOT>/run/deskflow-server.out.log</string>

  <key>StandardErrorPath</key>
  <string><MAC_SETUP_ROOT>/run/deskflow-server.err.log</string>

  <key>WorkingDirectory</key>
  <string><MAC_SETUP_ROOT></string>
</dict>
</plist>

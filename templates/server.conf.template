# Deskflow server config template for Mac server -> Windows client.
# Replace placeholders before use:
#   <MAC_SCREEN_NAME>
#   <WINDOWS_SCREEN_NAME>

section: screens
  <MAC_SCREEN_NAME>:
  <WINDOWS_SCREEN_NAME>:
    # Make Mac Command act like Windows Alt while controlling Windows.
    super = alt
    meta = alt
    alt = alt
    ctrl = ctrl
end

section: aliases
  <MAC_SCREEN_NAME>:
    <MAC_SCREEN_NAME>.local
  <WINDOWS_SCREEN_NAME>:
    <WINDOWS_SCREEN_NAME>.local
end

section: links
  <MAC_SCREEN_NAME>:
    right = <WINDOWS_SCREEN_NAME>
  <WINDOWS_SCREEN_NAME>:
    left = <MAC_SCREEN_NAME>
end

section: options
  switchDelay = 0
  relativeMouseMoves = false
  clipboardSharing = false
  clipboardSharingSize = 1024

  # Preferred direct switches.
  keystroke(shift+super+1) = switchToScreen(<MAC_SCREEN_NAME>)
  keystroke(shift+super+2) = switchToScreen(<WINDOWS_SCREEN_NAME>)

  # Fallbacks if Command maps differently in this Deskflow/macOS build.
  keystroke(shift+alt+1) = switchToScreen(<MAC_SCREEN_NAME>)
  keystroke(shift+alt+2) = switchToScreen(<WINDOWS_SCREEN_NAME>)

  # Helper-friendly directional bindings.
  keystroke(control+super+right) = switchInDirection(right)
  keystroke(control+super+left) = switchInDirection(left)
  keystroke(control+alt+right) = switchInDirection(right)
  keystroke(control+alt+left) = switchInDirection(left)
end

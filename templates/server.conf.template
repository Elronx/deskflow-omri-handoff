# Deskflow server config template for Mac server -> Windows client.
# Replace placeholders before use:
#   <MAC_SCREEN_NAME>
#   <WINDOWS_SCREEN_NAME>

section: screens
  <MAC_SCREEN_NAME>:
  <WINDOWS_SCREEN_NAME>:
    # Make Mac Command act like Windows Ctrl while controlling Windows.
    super = ctrl
    meta = ctrl
    alt = alt
    ctrl = ctrl
end

section: aliases
  <MAC_SCREEN_NAME>:
    <MAC_SCREEN_NAME>.local
  <WINDOWS_SCREEN_NAME>:
    <WINDOWS_SCREEN_NAME>.local
end

section: links
  <MAC_SCREEN_NAME>:
    right = <WINDOWS_SCREEN_NAME>
  <WINDOWS_SCREEN_NAME>:
    left = <MAC_SCREEN_NAME>
end

section: options
  switchDelay = 0
  relativeMouseMoves = true
  clipboardSharing = false
  clipboardSharingSize = 1024

  # Preferred direct switches.
  keystroke(shift+super+1) = switchToScreen(<WINDOWS_SCREEN_NAME>), lockCursorToScreen(on)
  keystroke(shift+super+2) = lockCursorToScreen(off), switchToScreen(<MAC_SCREEN_NAME>)

  # Fallbacks if Command maps differently in this Deskflow/macOS build.
  keystroke(shift+alt+1) = switchToScreen(<WINDOWS_SCREEN_NAME>), lockCursorToScreen(on)
  keystroke(shift+alt+2) = lockCursorToScreen(off), switchToScreen(<MAC_SCREEN_NAME>)

  # Helper-friendly directional bindings.
  keystroke(control+super+right) = switchInDirection(right), lockCursorToScreen(on)
  keystroke(control+super+left) = lockCursorToScreen(off), switchInDirection(left)
  keystroke(control+alt+right) = switchInDirection(right), lockCursorToScreen(on)
  keystroke(control+alt+left) = lockCursorToScreen(off), switchInDirection(left)
end
